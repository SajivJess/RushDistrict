# International digits, including country code. Leave blank for the preview.
WHATSAPP_BUSINESS_NUMBER=

# Sender verified in Resend. Used for email sign-in and approved unboxing coupons.
RESEND_API_KEY=
RUSH_EMAIL_FROM=

# Google Web OAuth credentials and the storefront origin, with no trailing path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RUSH_SITE_ORIGIN=

# Store Instagram profile handle used by the unboxing reward card (with or without @).
RUSH_INSTAGRAM_HANDLE=
